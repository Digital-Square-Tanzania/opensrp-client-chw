<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.smartregister</groupId>
  <artifactId>opensrp-client-opd</artifactId>
  <version>0.1.5-SNAPSHOT</version>
  <packaging>aar</packaging>
  <name>OpenSRP Client OPD</name>
  <description>OpenSRP Client OPD Library</description>
  <url>https://github.com/OpenSRP/opensrp-client-opd</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>opensrp</id>
      <name>OpenSRP Onadev</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git@github.com:OpenSRP/opensrp-client-opd.git</connection>
    <developerConnection>scm:git@github.com:OpenSRP/opensrp-client-opd.git</developerConnection>
    <url>https://github.com/OpenSRP/opensrp-client-opd</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>androidx.appcompat</groupId>
      <artifactId>appcompat</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.smartregister</groupId>
      <artifactId>opensrp-client-core</artifactId>
      <version>4.3.15-SNAPSHOT</version>
      <type>aar</type>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <artifactId>appcompat-v7</artifactId>
          <groupId>com.android.support</groupId>
        </exclusion>
