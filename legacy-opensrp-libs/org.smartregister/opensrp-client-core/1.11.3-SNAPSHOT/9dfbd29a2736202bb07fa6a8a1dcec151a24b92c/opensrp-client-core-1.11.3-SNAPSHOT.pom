  <modelVersion>4.0.0</modelVersion>
  <groupId>org.smartregister</groupId>
  <artifactId>opensrp-client-core</artifactId>
  <version>1.11.3-SNAPSHOT</version>
  <packaging>aar</packaging>
  <name>OpenSRP Client Core</name>
  <description>OpenSRP Client Core Application</description>
  <url>https://github.com/OpenSRP/opensrp-client-core</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>opensrp</id>
      <name>OpenSRP Onadev</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git@github.com:OpenSRP/opensrp-client-core.git</connection>
    <developerConnection>scm:git@github.com:OpenSRP/opensrp-client-core.git</developerConnection>
    <url>https://github.com/OpenSRP/opensrp-client-core</url>
  </scm>
