<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:weightSum="1">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/back_referrals_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:contentInsetStart="0dp"
            android:contentInsetLeft="0dp"
            android:contentInsetEnd="0dp"
            android:contentInsetRight="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetLeft="0dp"
            app:contentInsetRight="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_collapseMode="pin">

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/toolbar_title"
                style="@style/CustomFontTextViewStyle.ClientList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|start"
                android:paddingStart="0dp"
                android:paddingLeft="0dp"
                android:paddingEnd="0dp"
                android:paddingRight="0dp"
                android:text="@string/back_to_referrals"
                android:textColor="@color/customAppThemeBlue"
                android:textSize="17sp" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/details_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/record_feedback_bar"
        android:layout_below="@+id/app_bar"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp">

        <RelativeLayout
            android:id="@+id/referral_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Client Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/clientDetailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section Title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/client_details"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textColor="@color/primary" />

                    <!-- Client Name -->
                    <org.smartregister.view.customcontrols.CustomFontTextView
                        android:id="@+id/client_name"
                        style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />

                    <!-- Client Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:id="@+id/client_phone_layout"
                        android:visibility="gone"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/phone"
                                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                            <org.smartregister.view.customcontrols.CustomFontTextView
                                android:id="@+id/client_phone"
                                style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/accent" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/phone"
                            app:srcCompat="@drawable/ic_call_black_24dp"
                            app:tint="@color/primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/child_name_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/child_name_label"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/child_name"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_black"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/street_name_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/street_name"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/street_name"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:textStyle="normal" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/map_cue_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/map_cue"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/map_cue"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:textStyle="normal" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CareGiver/Treatment Supporter Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/care_giver_name_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/clientDetailsCard"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:layout_marginRight="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section Title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/care_giver"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textColor="@color/primary" />

                    <!-- Supporter Name -->
                    <org.smartregister.view.customcontrols.CustomFontTextView
                        android:id="@+id/care_giver_name"
                        style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />

                    <!-- Supporter Phone -->
                    <LinearLayout
                        android:id="@+id/care_giver_phone_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/phone"
                                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                            <org.smartregister.view.customcontrols.CustomFontTextView
                                android:id="@+id/care_giver_phone"
                                style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/accent" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/phone"
                            app:srcCompat="@drawable/ic_call_black_24dp"
                            app:tint="@color/primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--  Referral Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/referral_details_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/care_giver_name_layout"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <!-- Section Title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/referral_details"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                        android:textColor="@color/primary" />

                    <LinearLayout
                        android:id="@+id/client_referral_problem_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/client_referral_problem_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/referred_clinic"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/client_referral_problem"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="35"
                            android:textColor="@color/text_black" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/referral_date_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/referral_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/referral_date"
                            android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/referral_date"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/last_visit_date_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/last_visit_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_facility_visit_date"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/last_visit_date"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_black"
                            android:textStyle="normal" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chw_details_bottom_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/chw_details_names_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chw_details"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/chw_details_names"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chw_details_phone_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/chw_details_phone_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chw_phone"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

                        <org.smartregister.view.customcontrols.CustomFontTextView
                            android:id="@+id/chw_details_phone"
                            style="@style/CustomFontTextViewStyle.ListView.Normal.NoPadding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:textColor="@color/opensrp_primary"
                            android:textSize="17sp"
                            android:textStyle="normal" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/record_feedback_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <View
            android:id="@+id/view_referal_row"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/light_grey"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/record_visit_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view_referal_row"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:visibility="visible">

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/record_feedback"
                style="@style/CustomFontTextViewStyle.ListView.Normal.MultipleLines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_weight="1"
                android:background="@drawable/record_btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal|center_vertical"
                android:paddingStart="30dp"
                android:paddingTop="10dp"
                android:paddingEnd="30dp"
                android:paddingBottom="10dp"
                android:text="@string/record_followup_feedback"
                android:textAllCaps="true"
                android:textColor="@color/white" />

            <org.smartregister.view.customcontrols.CustomFontTextView
                android:id="@+id/view_profile"
                style="@style/CustomFontTextViewStyle.ListView.Normal.MultipleLines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:paddingStart="30dp"
                android:paddingTop="10dp"
                android:paddingEnd="30dp"
                android:paddingBottom="10dp"
                android:text="@string/view_profile"
                android:textAllCaps="true"
                android:textColor="@color/opensrp_primary"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
