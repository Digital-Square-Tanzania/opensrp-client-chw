<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@android:color/white">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="?attr/colorPrimary"
        android:theme="@style/AppTheme.AppBarOverlay" app:title="@string/mothermentor_link_child_eid" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:text="@string/mothermentor_child_eid_eligibility"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1" />
    <TextView android:id="@+id/child_from_household"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:gravity="center_vertical" android:padding="20dp"
        android:background="?attr/selectableItemBackground" android:drawableEnd="@drawable/row_goto"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:text="@string/mothermentor_child_eid_household" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/child_from_all_clients"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:gravity="center_vertical" android:padding="20dp"
        android:background="?attr/selectableItemBackground" android:drawableEnd="@drawable/row_goto"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:text="@string/mothermentor_child_eid_all_clients" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/child_register_new"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:gravity="center_vertical" android:padding="20dp"
        android:background="?attr/selectableItemBackground" android:drawableEnd="@drawable/row_goto"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:text="@string/mothermentor_child_eid_new_client" android:clickable="true" android:focusable="true" />
</LinearLayout>
