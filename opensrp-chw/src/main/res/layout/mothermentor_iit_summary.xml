<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iit_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <org.smartregister.view.customcontrols.CustomFontTextView
        android:id="@+id/iit_summary_missed_label"
        style="@style/MotherMentorIitSummaryText.Label"
        android:text="@string/mothermentor_iit_summary_missed_label" />

    <org.smartregister.view.customcontrols.CustomFontTextView
        android:id="@+id/iit_summary_missed_value"
        style="@style/MotherMentorIitSummaryText"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:id="@+id/iit_summary_closure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <org.smartregister.view.customcontrols.CustomFontTextView
            android:id="@+id/iit_summary_closure_label"
            style="@style/MotherMentorIitSummaryText.Label"
            android:text="@string/mothermentor_iit_closure_reason" />

        <org.smartregister.view.customcontrols.CustomFontTextView
            android:id="@+id/iit_summary_closure_value"
            style="@style/MotherMentorIitSummaryText"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
