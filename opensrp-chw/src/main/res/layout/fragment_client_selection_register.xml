<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/client_list_header_dark_grey">

    <!-- Minimal toolbar stub with expected ids used by base OPD -->
    <androidx.appcompat.widget.Toolbar
        android:id="@id/register_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:contentInsetLeft="0dp"
        android:contentInsetStartWithNavigation="0dp">
        <TextView
            android:id="@id/txt_title_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@android:color/white"
            android:visibility="visible" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Optional nav bar container stub expected by some base fragments (kept in case toolbar include lacks it) -->
    <FrameLayout
        android:id="@id/register_nav_bar_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Minimal search bar (no filters/due-only) with expected ids for base wiring -->
    <LinearLayout
        android:id="@id/search_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/search_bar_background_black"
        android:gravity="center_vertical">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/ec_main_header_search_layout_height"
            android:layout_marginStart="@dimen/register_search_bar_margin"
            android:layout_marginEnd="@dimen/register_search_bar_min_margin"
            android:layout_weight="1.0">

            <EditText
                android:id="@id/edt_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="0dp"
                android:background="@drawable/grey_edit_text_shape"
                android:ellipsize="end"
                android:hint="@string/search_hint"
                android:maxLines="1"
                android:minWidth="100dp"
                android:padding="@dimen/register_search_bar_padding"
                android:textColor="@android:color/white"
                android:textColorHint="@color/search_hint_white"
                android:textSize="@dimen/default_font_size_search_bar" />

            <ImageButton
                android:id="@id/btn_search_cancel"
                android:layout_width="@dimen/ec_main_header_search_cancel_button_width"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/search_view_cancel_image_margin_right"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_cross"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Placeholder left/right containers expected by some bases -->
        <RelativeLayout
            android:id="@id/top_left_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/ec_main_header_search_layout_height"
            android:layout_marginStart="@dimen/search_bar_min_margin"
            android:layout_weight="0.0"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@id/top_right_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/ec_main_header_search_layout_height"
            android:layout_marginEnd="@dimen/register_search_bar_margin"
            android:layout_weight="0.0"
            android:visibility="gone" />

        <!-- Placeholder filter/sort lane (hidden) to satisfy base expectations -->
        <RelativeLayout
            android:id="@id/filter_sort_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/ec_main_header_search_layout_height"
            android:layout_marginEnd="@dimen/register_search_bar_margin"
            android:layout_marginStart="@dimen/search_bar_min_margin"
            android:layout_weight="0.0"
            android:visibility="gone" />

        <!-- Placeholder due-only lane (hidden) to satisfy base expectations -->
        <RelativeLayout
            android:id="@id/due_only_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/ec_main_header_search_layout_height"
            android:layout_marginEnd="@dimen/register_search_bar_margin"
            android:layout_marginStart="@dimen/search_bar_min_margin"
            android:layout_weight="0.0"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/clients_header_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_header_height"
        android:layout_marginStart="@dimen/list_view_margin_left_and_right"
        android:layout_marginEnd="@dimen/list_view_margin_left_and_right"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- Placeholder sort/filter bar root id expected by base -->
    <LinearLayout
        android:id="@id/register_sort_filter_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/listview_background_rounded">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:visibility="invisible" />

        <ProgressBar
            android:id="@+id/client_list_progress"
            style="@android:style/Widget.Holo.Light.ProgressBar.Large.Inverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/no_record"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
