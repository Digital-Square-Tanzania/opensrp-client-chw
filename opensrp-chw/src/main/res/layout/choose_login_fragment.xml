<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F6F6F6">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <org.smartregister.view.customcontrols.CustomFontTextView
            android:id="@+id/tvAppName" style="@style/CustomFontTextViewStyle.Header.Black"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center" android:text="@string/app_name"
            android:textSize="24sp" android:singleLine="false" android:maxLines="100" />
        <org.smartregister.view.customcontrols.CustomFontTextView
            android:id="@+id/tvUseText" style="@style/CustomFontTextViewStyle.ClientList.Bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/ui_choose_sign_in"
            android:textSize="20sp" android:singleLine="false" android:maxLines="100" />
        <org.smartregister.view.customcontrols.CustomFontTextView
            android:id="@+id/tvInstructions" style="@style/CustomFontTextViewStyle.ClientList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/use_4_digit_pin_number_promt"
            android:textColor="@color/ui_text_secondary" android:textSize="18sp"
            android:singleLine="false" android:maxLines="100" />
        <Button android:id="@+id/btnUsePin" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:minHeight="56dp" android:padding="12dp"
            android:background="@drawable/login_button_bg" android:text="@string/ui_use_pin"
            android:textColor="@color/white" android:textSize="18sp" />
        <Button android:id="@+id/btnUsePassword" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="56dp" android:padding="12dp"
            android:background="?attr/selectableItemBackground" android:text="@string/ui_use_password"
            android:textColor="@color/ui_text_secondary" android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
