<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/register_columns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="92dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/patient_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/patient_name_age" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_black" android:textSize="17sp" android:textStyle="bold" android:maxLines="2" />
        <TextView android:id="@+id/client_metadata" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textColor="#666666" android:textSize="14sp" android:maxLines="2" />
        <TextView android:id="@+id/pregnancy_week" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#666666" android:textSize="14sp" android:visibility="gone" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp"
        android:text="›" android:textColor="@color/customAppThemeBlue" android:textSize="34sp" />
</LinearLayout>
