<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/all_clients_dashboard_background"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/due_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/all_clients_dashboard_blue"
        app:title="@string/due_services_title"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />
    <TextView android:id="@+id/due_register_coverage"
        style="@style/AllClientsDashboardSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:padding="12dp"
        android:accessibilityLiveRegion="polite" />
    <RadioGroup android:id="@+id/due_register_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <RadioButton android:id="@+id/due_filter_due"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/due_services_due" />
        <RadioButton android:id="@+id/due_filter_overdue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/due_services_overdue" />
    </RadioGroup>
    <EditText android:id="@+id/due_register_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:minHeight="48dp"
        android:hint="@string/due_services_search"
        android:inputType="textPersonName"
        android:imeOptions="actionSearch"
        android:maxLines="1" />
    <TextView android:id="@+id/due_register_date"
        style="@style/AllClientsDashboardSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp" />
    <TextView style="@style/AllClientsDashboardSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/due_services_precedence" />
    <ProgressBar android:id="@+id/due_register_loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/due_services_loading"
        android:visibility="gone" />
    <TextView android:id="@+id/due_register_empty"
        style="@style/AllClientsDashboardSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/due_register_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />
</LinearLayout>
