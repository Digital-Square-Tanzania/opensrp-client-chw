<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_due_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView style="@style/AllClientsDashboardHeading"
        android:text="@string/due_services_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/dashboard_due_card"
            style="@style/AllClientsDashboardStat"
            android:layout_marginEnd="4dp"
            android:background="@drawable/all_clients_dashboard_action"
            android:clickable="true"
            android:focusable="true">
            <TextView android:id="@+id/dashboard_due_count"
                style="@style/AllClientsDashboardStatValue" />
            <TextView style="@style/AllClientsDashboardStatLabel"
                android:labelFor="@id/dashboard_due_count"
                android:text="@string/due_services_due" />
        </LinearLayout>
        <LinearLayout android:id="@+id/dashboard_overdue_card"
            style="@style/AllClientsDashboardStat"
            android:layout_marginStart="4dp"
            android:background="@drawable/all_clients_dashboard_action"
            android:clickable="true"
            android:focusable="true">
            <TextView android:id="@+id/dashboard_overdue_count"
                style="@style/AllClientsDashboardStatValue"
                android:textColor="@color/all_clients_dashboard_amber" />
            <TextView style="@style/AllClientsDashboardStatLabel"
                android:labelFor="@id/dashboard_overdue_count"
                android:text="@string/due_services_overdue" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/dashboard_due_coverage"
        style="@style/AllClientsDashboardSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
