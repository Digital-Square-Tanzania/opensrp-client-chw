<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/all_clients_dashboard_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/all_clients_dashboard_blue">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/register_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="64dp"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

        <TextView
            android:id="@+id/txt_title_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:minHeight="64dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/all_clients_dashboard_title"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/dashboard_greeting"
                style="@style/AllClientsDashboardSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_clients_dashboard_greeting_default" />

            <TextView
                android:id="@+id/dashboard_date"
                style="@style/AllClientsDashboardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dashboard_location"
                style="@style/AllClientsDashboardSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/dashboard_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/all_clients_dashboard_loading"
                android:indeterminateTint="@color/all_clients_dashboard_blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dashboard_error"
                style="@style/AllClientsDashboardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/all_clients_dashboard_action"
                android:clickable="true"
                android:focusable="true"
                android:accessibilityLiveRegion="polite"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:padding="12dp"
                android:text="@string/all_clients_dashboard_error"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/AllClientsDashboardStat"
                    android:layout_marginEnd="4dp">
                    <TextView android:id="@+id/dashboard_total"
                        style="@style/AllClientsDashboardStatValue" />
                    <TextView style="@style/AllClientsDashboardStatLabel"
                        android:labelFor="@id/dashboard_total"
                        android:text="@string/all_clients_dashboard_total" />
                </LinearLayout>

                <LinearLayout style="@style/AllClientsDashboardStat"
                    android:layout_marginStart="4dp">
                    <TextView android:id="@+id/dashboard_modules"
                        style="@style/AllClientsDashboardStatValue" />
                    <TextView style="@style/AllClientsDashboardStatLabel"
                        android:labelFor="@id/dashboard_modules"
                        android:text="@string/all_clients_dashboard_modules" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/AllClientsDashboardStat"
                    android:layout_marginEnd="4dp">
                    <TextView android:id="@+id/dashboard_unlinked"
                        style="@style/AllClientsDashboardStatValue" />
                    <TextView style="@style/AllClientsDashboardStatLabel"
                        android:labelFor="@id/dashboard_unlinked"
                        android:text="@string/all_clients_dashboard_unlinked" />
                </LinearLayout>

                <LinearLayout style="@style/AllClientsDashboardStat"
                    android:layout_marginStart="4dp">
                    <TextView android:id="@+id/dashboard_new_week"
                        style="@style/AllClientsDashboardStatValue" />
                    <TextView style="@style/AllClientsDashboardStatLabel"
                        android:labelFor="@id/dashboard_new_week"
                        android:text="@string/all_clients_dashboard_new_week" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/AllClientsDashboardHeading"
                android:text="@string/all_clients_dashboard_quick_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/dashboard_view_clients"
                    style="@style/AllClientsDashboardAction"
                    android:layout_marginEnd="4dp"
                    android:drawableStart="@drawable/all_clients_dashboard_ic_clients"
                    android:text="@string/all_clients_dashboard_view_clients" />
                <TextView
                    android:id="@+id/dashboard_add_client"
                    style="@style/AllClientsDashboardAction"
                    android:layout_marginStart="4dp"
                    android:drawableStart="@drawable/all_clients_dashboard_ic_add"
                    android:text="@string/all_clients_dashboard_add_client" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/dashboard_search_clients"
                    style="@style/AllClientsDashboardAction"
                    android:layout_marginEnd="4dp"
                    android:drawableStart="@drawable/all_clients_dashboard_ic_search"
                    android:text="@string/all_clients_dashboard_search_clients" />
                <TextView
                    android:id="@+id/dashboard_sync"
                    style="@style/AllClientsDashboardAction"
                    android:layout_marginStart="4dp"
                    android:drawableStart="@drawable/all_clients_dashboard_ic_sync"
                    android:text="@string/all_clients_dashboard_sync" />
            </LinearLayout>

            <TextView
                android:id="@+id/dashboard_empty"
                style="@style/AllClientsDashboardSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:padding="12dp"
                android:text="@string/all_clients_dashboard_empty"
                android:visibility="gone" />

            <TextView style="@style/AllClientsDashboardHeading"
                android:text="@string/all_clients_dashboard_breakdown" />

            <LinearLayout
                android:id="@+id/dashboard_breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/AllClientsDashboardSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/all_clients_dashboard_breakdown_note"
                android:textSize="12sp" />

            <TextView style="@style/AllClientsDashboardHeading"
                android:text="@string/all_clients_dashboard_recent" />

            <LinearLayout
                android:id="@+id/dashboard_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
