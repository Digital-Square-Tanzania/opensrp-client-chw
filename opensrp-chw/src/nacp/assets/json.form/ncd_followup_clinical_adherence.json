      {
        "key": "counseling_forgot",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Counselling\"</b><br> Help client use daily medication reminders<br><br><font color=\"#0061A4\"><i>Tap </i><b>ⓘ</b><i> for the full counselling guide</i></font>",
        "toaster_type": "info",
        "toaster_info_title": "Supporting Medication Adherence — Forgot",
        "toaster_info_text": "Taking your diabetes and blood pressure medications exactly as prescribed is very important to keep your blood sugar and blood pressure under control.\n\nYou can use reminders like phone alarms or link your medication to daily routines such as meals.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "ncd_followup_clinical_adherence_relevance.yml"
            }
          }
        }
      },
      {
        "key": "counseling_felt_better",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Counselling\"</b><br> Medication must continue even when feeling well<br><br><font color=\"#0061A4\"><i>Tap </i><b>ⓘ</b><i> for the full counselling guide</i></font>",
        "toaster_type": "info",
        "toaster_info_title": "Why Continue Medication When Feeling Well",
        "toaster_info_text": "It is important to continue taking your diabetes and blood pressure medications exactly as prescribed, even when you feel well.\n\nStopping your medication can cause your blood sugar and blood pressure to rise again, increasing the risk of serious complications such as stroke, heart disease, kidney damage, and vision problems.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "ncd_followup_clinical_adherence_relevance.yml"
            }
          }
        }
      },
      {
        "key": "counseling_side_effects",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Side effects reported\"</b><br> Advise client to visit clinic<br><br><font color=\"#0061A4\"><i>Tap </i><b>ⓘ</b><i> for the full counselling guide</i></font>",
        "toaster_type": "warning",
        "toaster_info_title": "Managing Medication Side Effects",
        "toaster_info_text": "It is important not to stop your diabetes and blood pressure medications without consulting a healthcare provider.\n\nSide effects can often be managed by adjusting the dose or changing the medication. Please visit the clinic so that the health care provider can help you.\n\nA non-emergency referral task will be created when this form is submitted.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "ncd_followup_clinical_adherence_relevance.yml"
            }
          }
        }
      },
      {
        "key": "counseling_stock_out",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Counselling\"</b><br> Help client access medication supply<br><br><font color=\"#0061A4\"><i>Tap </i><b>ⓘ</b><i> for the full counselling guide</i></font>",
        "toaster_type": "info",
        "toaster_info_title": "Medication Supply Challenges",
        "toaster_info_text": "It is very important to continue taking your diabetes and blood pressure medications as prescribed, even if the clinic is far.\n\nLet us know about the challenges you are facing — there may be options such as getting a longer supply of medication, support from a nearby facility, or community follow-up to help you continue your treatment.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "ncd_followup_clinical_adherence_relevance.yml"
            }
          }
        }
      },
      {
        "key": "counseling_transport_cost",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Counselling\"</b><br> Help client overcome transport barriers<br><br><font color=\"#0061A4\"><i>Tap </i><b>ⓘ</b><i> for the full counselling guide</i></font>",
        "toaster_type": "info",
        "toaster_info_title": "Transport and Access to Medication",
        "toaster_info_text": "It is very important to continue taking your diabetes and blood pressure medications as prescribed, even when you don't have transport fare.\n\nLet us know about the challenges you are facing — there may be options such as getting a longer supply of medication, support from a nearby facility, or community follow-up to help you continue your treatment.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
