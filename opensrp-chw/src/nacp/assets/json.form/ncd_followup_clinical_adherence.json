        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Non-Emergency Referral\"</b><br> Client missed clinic last month<br><br><font color=\"#0061A4\"><i>Tap </i><b>ⓘ</b><i> for the full counselling guide</i></font>",
        "toaster_type": "warning",
        "toaster_info_title": "Why Regular Clinic Attendance Matters",
        "toaster_info_text": "Regular clinic attendance is very important for managing your diabetes and blood pressure and to detect any problems early.\n\nMissing your appointments can lead to uncontrolled blood sugar and blood pressure, which increases the risk of serious complications such as stroke, heart disease, kidney damage, and vision problems.\n\nA non-emergency referral task will be created when this form is submitted.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "ncd_followup_clinical_adherence_relevance.yml"
            }
          }
        }
