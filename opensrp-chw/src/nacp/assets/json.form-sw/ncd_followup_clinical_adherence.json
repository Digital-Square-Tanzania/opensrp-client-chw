      {
        "key": "counseling_forgot",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Ushauri\"</b><br> Msaidie mteja kutumia vikumbusho vya dawa kila siku<br><br><font color=\"#0061A4\"><i>Bonyeza </i><b>ⓘ</b><i> kusoma zaidi</i></font>",
        "toaster_type": "info",
        "toaster_info_title": "Kusaidia Kufuata Dawa — Alisahau",
        "toaster_info_text": "Kunywa dawa za kisukari na shinikizo la damu kwa usahihi kama ulivyoelekezwa ni muhimu sana ili kudhibiti sukari na shinikizo la damu.\n\nUnaweza kutumia vikumbusho kama alarm ya simu au kuhusisha muda wa dawa na ratiba zako za kila siku kama vile wakati wa kula.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
