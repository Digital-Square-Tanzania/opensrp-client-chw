            }
          }
        }
      },
      {
        "key": "counseling_felt_better",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Ushauri\"</b><br> Dawa lazima iendelezwe hata ukijisikia vizuri<br><br><font color=\"#0061A4\"><i>Bonyeza </i><b>ⓘ</b><i> kusoma zaidi</i></font>",
        "toaster_type": "info",
        "toaster_info_title": "Kwa Nini Endelea na Dawa Ukijisikia Vizuri",
        "toaster_info_text": "Ni muhimu kuendelea kutumia dawa za kisukari na shinikizo la damu kama ulivyoelekezwa, hata kama unajisikia vizuri.\n\nKuacha kutumia dawa kunaweza kusababisha sukari na shinikizo la damu kupanda tena, na kuongeza hatari ya madhara makubwa kama kiharusi, magonjwa ya moyo, matatizo ya figo, na matatizo ya macho.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "ncd_followup_clinical_adherence_relevance.yml"
            }
          }
        }
      },
      {
        "key": "counseling_side_effects",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Madhara ya dawa\"</b><br> Mshauri mteja atembelee kliniki<br><br><font color=\"#0061A4\"><i>Bonyeza </i><b>ⓘ</b><i> kusoma zaidi</i></font>",
        "toaster_type": "warning",
        "toaster_info_title": "Kusimamia Madhara ya Dawa",
        "toaster_info_text": "Ni muhimu kutokuacha kutumia dawa za kisukari na shinikizo la damu bila kushauriana na mtoa huduma za afya.\n\nMadhara ya dawa mara nyingi yanaweza kudhibitiwa kwa kurekebisha dozi au kubadilisha dawa. Tafadhali tembelea kliniki ili mtoa huduma za afya aweze kukusaidia.\n\nKazi ya rufaa itaundwa fomu hii inapowasilishwa.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "ncd_followup_clinical_adherence_relevance.yml"
            }
          }
        }
      },
      {
        "key": "counseling_stock_out",
        "openmrs_entity_parent": "",
        "openmrs_entity": "",
        "openmrs_entity_id": "",
        "type": "toaster_notes",
        "text": "<b>\"Ushauri\"</b><br> Msaidie mteja kupata dawa zahanati<br><br><font color=\"#0061A4\"><i>Bonyeza </i><b>ⓘ</b><i> kusoma zaidi</i></font>",
        "toaster_type": "info",
        "toaster_info_title": "Changamoto za Dawa Zahanati",
        "toaster_info_text": "Ni muhimu sana kuendelea kutumia dawa za kisukari na shinikizo la damu kama ulivyoelekezwa, hata kama kituo cha afya kiko mbali.\n\nTujulishe changamoto unazokutana nazo, kunaweza kuwa na njia za kukusaidia kama kupata dawa za muda mrefu zaidi, kupata huduma katika kituo cha karibu, au ufuatiliaji wa karibu katika jamii.",
        "relevance": {
          "rules-engine": {
            "ex-rules": {
