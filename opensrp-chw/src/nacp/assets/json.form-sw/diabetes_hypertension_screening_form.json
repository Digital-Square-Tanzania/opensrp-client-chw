      {
        "key": "systolic_bp",
        "type": "edit_text",
        "hint": "Shinikizo la damu (Systolic) (mmHg)",
        "openmrs_entity": "concept",
        "openmrs_entity_id": "systolic_bp",
        "openmrs_entity_parent": "",
        "label_info_title": "Kuhusu nambari ya juu (systolic)",
        "label_info_text": "Maana yake: Ni nambari ya JUU unayoiona unapopima shinikizo la damu. Inaonyesha jinsi damu inavyosukumwa kwa nguvu wakati moyo unapodunda.\n\nKawaida: chini ya 120.\nImepanda kidogo: 120 hadi 139 — ongea na mteja kuhusu tabia za kiafya (kupunguza chumvi, kufanya mazoezi zaidi, kupunguza pombe, kuacha sigara) na uangalie tena ziara ijayo.\nIko juu: 140 au zaidi.\n\nJinsi ya kupima vizuri:\n- Acha mteja akae kimya kwa angalau dakika 5 kabla ya kuanza.\n- Miguu iko sakafuni, mgongo umeegemea kiti, mkono umelala juu ya meza katika kiwango cha moyo.\n- Cuff (mkanda wa kupimia) inapaswa kufaa mkono — siyo ya kubana sana wala ya kulegea. Iweke kwenye ngozi iliyo wazi.\n- Mteja asiwe amevuta sigara, hajakunywa kahawa au chai, na hajafanya mazoezi katika dakika 30 zilizopita.\n- Chukua vipimo VIWILI kwa muda wa dakika 1-2 kati yake, na utumie wastani. Kama vipimo viwili vinatofautiana sana (zaidi ya 10), chukua kipimo cha tatu.\n\nAndika nambari hasa kama unavyoiona kwenye kifaa.",
        "v_numeric": {
          "value": "true",
          "err": "Tafadhali ingiza nambari"
        },
        "v_min": {
          "value": "50",
          "err": "Kiwango lazima kiwe sawa au kikubwa kuliko 50"
        },
        "v_max": {
          "value": "320",
          "err": "Kiwango lazima kiwe sawa au kidogo kuliko 320"
        },
        "v_required": {
          "value": true,
          "err": "Tafadhali ingiza shinikizo la juu la damu"
        },
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "diabetes_hypertension_screening_relevance.yml"
            }
          }
        }
      },
      {
        "key": "diastolic_bp",
        "type": "edit_text",
        "hint": "Shinikizo la damu (Diastolic) (mmHg)",
        "openmrs_entity": "concept",
        "openmrs_entity_id": "diastolic_bp",
        "openmrs_entity_parent": "",
        "label_info_title": "Kuhusu nambari ya chini (diastolic)",
        "label_info_text": "Maana yake: Ni nambari ya CHINI unayoiona unapopima shinikizo la damu. Inaonyesha shinikizo wakati moyo unapopumzika kati ya mapigo.\n\nKawaida: chini ya 80.\nImepanda kidogo: 80 hadi 89 — ongea na mteja kuhusu tabia za kiafya na uangalie tena ziara ijayo.\nIko juu: 90 au zaidi.\n\nMuhimu: Nambari ya chini lazima daima iwe ndogo kuliko nambari ya juu. Kama nambari ya chini ni sawa na au kubwa kuliko ya juu, hakikisha cuff iko vizuri kisha pima tena.\n\nTumia hatua zile zile kama za nambari ya juu: mteja akae kimya kwa dakika 5, mkono katika kiwango cha moyo, cuff sahihi kwenye ngozi iliyo wazi, asiwe amevuta sigara au kunywa kahawa au kufanya mazoezi katika dakika 30 zilizopita.",
        "v_numeric": {
          "value": "true",
          "err": "Tafadhali ingiza nambari"
        },
        "v_min": {
          "value": "30",
          "err": "Nambari hii ni ndogo mno kwa shinikizo la chini la damu"
        },
        "v_max": {
          "value": "200",
          "err": "Nambari hii ni kubwa mno kwa shinikizo la chini la damu"
        },
        "v_required": {
          "value": true,
          "err": "Tafadhali ingiza shinikizo la chini la damu"
        },
        "constraints": [
          {
            "type": "numeric",
            "ex": "lessThan(., step3:systolic_bp)",
            "err": "Shinikizo la damu (diastolic) linatikiwa liwe dogo kuliko shinikizo la damu (systolic)"
          }
        ],
        "relevance": {
          "rules-engine": {
            "ex-rules": {
              "rules-file": "diabetes_hypertension_screening_relevance.yml"
            }
          }
        }
      }
    ]
  },
