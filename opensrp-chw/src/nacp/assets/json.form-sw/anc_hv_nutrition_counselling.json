      },
      {
        "key": "traditional_herbs_warning",
        "openmrs_entity_parent": "",
        "openmrs_entity": "concept",
        "openmrs_entity_id": "nutrition_restrictions_note",
        "type": "toaster_notes",
        "text": "Ningependa kujadili kuhusu matumizi ya dawa za kienyeji wakati wa ujauzito na madhara yake kwa afya yako na ya mtoto wako ambaye hajazaliwa.\nWanawake wengi hutumia mitishamba ili kuponya maumivu ya tumbo, kupunguza maumivu ya asubuhi na kuongeza damu wakati wa ujauzito. Hata hivyo, miti shamba hii ikitumika kwa wingi na bila kushauriana na daktari inaweza kusababisha shinikizo la damu kushuka/kupanda, kuharibika kwa mimba, kuzaliwa kwa mtoto mgonjwa wa akili/kimwili na wakati mwingine kifo kwa mama, mtoto au wote wawili.",
        "text_color": "#2C0000",
        "toaster_type": "info"
      },
